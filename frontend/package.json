{
  "name": "frontend",
  "main": "index.js",
  "version": "2.0.3",
  "scripts": {
    "start": "set NODE_ENV=development&& react-native start --port 8082",
    "start:tunnel": "npx expo start --tunnel --clear --scheme proparcel --port 8082",
    "start:dev": "set NODE_ENV=development&& react-native start --reset-cache --port 8082",
    "dev:iphone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan",
    "iphone:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan",
    "iphone:dev:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan",
    "iphone:dev:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Tunnel",
    "iphone:fix": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Tunnel -ForceRestart -Clear",
    "iphone:decode-url": "node ./scripts/decode-metro-url.js",
    "iphone:url": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios.ps1",
    "start:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios.ps1",
    "start:ios_metro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan",
    "start:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android.ps1",
    "start:android_metro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1",
    "start:ios-dev": "set NODE_ENV=development&& set CI=&& npx expo start --dev-client --lan --scheme proparcel --port 8081",
    "start:ios-dev:tunnel": "set NODE_ENV=development&& set CI=&& npx expo start --dev-client --tunnel --scheme proparcel --port 8081",
    "start:metro:devclient": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1 -MetroOnly",
    "metro:window": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1 -MetroOnly",
    "metro:window:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan -MetroOnly",
    "metro:window:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1 -MetroOnly",
    "metro:fg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_ios_metro.ps1 -Lan -ForceRestart -Clear",
    "metro:focus": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/focus-metro-window.ps1",
    "metro:focus:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/focus-metro-window.ps1 -Platform ios",
    "metro:focus:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/focus-metro-window.ps1 -Platform android",
    "stop:metro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-metro.ps1 -Platform android",
    "stop:metro:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-metro.ps1 -Platform android",
    "stop:metro:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-metro.ps1 -Platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "gen:model-packs-manifest": "node ./scripts/generate-models-pack-manifest.js",
    "gen:android-asset-packs": "node ./scripts/generate-android-asset-packs.js",
    "clear:android-asset-packs": "node ./scripts/clear-android-asset-packs.js",
    "gen:debug-assets-models": "node ./scripts/copy-models-to-debug-assets.js",
    "compress-glb": "node ./scripts/compress-glb-for-mobile.js",
    "inspect-glb": "node ./scripts/inspect-glb.js",
    "glb-to-minimal-pbr": "node ./scripts/glb-to-minimal-pbr.js",
    "optimize-glb": "node ./scripts/optimize_glb.js",
    "debug:handlers": "tsx scripts/dump-and-parse-handlers.ts",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1",
    "android:setup": "npm run prebuild:android:safe",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1",
    "android:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android_metro.ps1",
    "android:embed-models": "npm run gen:model-packs-manifest && npm run gen:android-asset-packs && npm run gen:debug-assets-models",
    "android:run-only": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start_android.ps1 -Release",
    "build:apk": "cd android && gradlew.bat assembleRelease",
    "build:apk:no-models": "npm run clear:android-asset-packs && cd android && gradlew.bat assembleRelease",
    "build:apk:with-models": "npm run android:embed-models && cd android && gradlew.bat assembleRelease",
    "refresh:android-asset-packs": "node ./scripts/refresh-android-asset-packs.js",
    "build:bundle:no-models": "node ./scripts/prepare-release-policy.js && node ./scripts/sync-release-keystore.js && node ./scripts/sync-android-mapbox-token.js --strict && npm run clear:android-asset-packs && cd android && gradlew.bat bundleRelease && cd .. && node ./scripts/copy-release-aab.js --variant=no-models",
    "build:bundle:with-models": "node ./scripts/prepare-release-policy.js && node ./scripts/sync-android-mapbox-token.js --strict && npm run gen:model-packs-manifest && npm run refresh:android-asset-packs && cd android && gradlew.bat bundleRelease && cd .. && node ./scripts/copy-release-aab.js --variant=with-models",
    "release:policy": "node ./scripts/prepare-release-policy.js",
    "release:policy:force": "node ./scripts/prepare-release-policy.js --force",
    "release:policy:optional": "node ./scripts/prepare-release-policy.js --optional",
    "deploy:release-policy": "node ./scripts/deploy-release-policy.js",
    "ios": "expo run:ios",
    "unlock:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/unlock-android-folder.ps1",
    "android:setup:temp": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-setup-temp.ps1",
    "schedule:android-delete-reboot": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/schedule-android-delete-reboot.ps1",
    "prebuild:android": "set EXPO_ANDROID_RN_CLI=1&& npx expo prebuild --platform android --clean && node ./scripts/apply-android-native-fix.js",
    "prebuild:android:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/unlock-android-folder.ps1 && set EXPO_ANDROID_RN_CLI=1&& npx expo prebuild --platform android --clean && node ./scripts/apply-android-native-fix.js",
    "android:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-dev-usb.ps1",
    "ios:usb": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ios-dev-usb.ps1",
    "android:reinstall": "npm run android:usb && npm run android:run-only",
    "fix:android-native": "node ./scripts/apply-android-native-fix.js",
    "android:sha256": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/print-android-sha256.ps1",
    "fix:androidx": "node ./scripts/apply-android-native-fix.js",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "prebuild:ios:clean": "npx expo prebuild --platform ios --clean",
    "clean:android-build": "powershell -NoProfile -File ./scripts/clean-android-build.ps1",
    "validate:unity-export": "set UNITY_EXPORT_VALIDATE_MODE=terrain&& node ./scripts/validate-unity-export.js",
    "validate:unity-smoke-export": "set UNITY_EXPORT_VALIDATE_MODE=smoke&& node ./scripts/validate-unity-export.js",
    "validate:unity-terrain-export": "set UNITY_EXPORT_VALIDATE_MODE=terrain&& node ./scripts/validate-unity-export.js",
    "terrain:logs": "node ./scripts/read-terrain-logs.js",
    "terrain:logs:latest": "node ./scripts/read-terrain-logs.js",
    "clean:eas-temp": "powershell -NoProfile -File ./scripts/clean-eas-temp.ps1",
    "clean:eas-upload": "powershell -NoProfile -File ./scripts/clean-eas-upload.ps1",
    "clean:eas-upload:native": "powershell -NoProfile -File ./scripts/clean-eas-upload.ps1 -IncludeNativeFolders",
    "mapbox:doctor": "node ./scripts/doctor-mapbox-env.js",
    "eas:sync-env": "node ./scripts/sync-eas-env.js",
    "eas:inspect:ios": "npm run eas:sync-env && npm run clean:eas-upload:native && npm run clean:eas-temp && set EAS_NO_VCS=1&& set NODE_ENV=development&& eas build:inspect --platform ios --stage archive --profile development --output %TEMP%\\eas-archive-inspect",
    "check:brand-assets": "node ./scripts/check-brand-assets.js",
    "eas:build:ios": "npm run check:brand-assets && npm run eas:sync-env && npm run clean:eas-upload:native && set EAS_NO_VCS=1&& set NODE_ENV=development&& eas build --platform ios --profile development",
    "eas:app-store-prep": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/app-store-hazirlik.ps1",
    "eas:setup-store": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-ios-app-store.ps1",
    "eas:configure-ios-store": "set EAS_NO_VCS=1&& eas credentials:configure-build -p ios -e production",
    "eas:release:ios": "npm run check:brand-assets && npm run eas:sync-env && npm run clean:eas-upload && set EAS_NO_VCS=1&& set NODE_ENV=production&& set EAS_BUILD_NO_EXPO_GO_WARNING=true&& eas build --platform ios --profile production --non-interactive",
    "eas:store:ios": "npm run eas:release:ios && npm run eas:submit:ios",
    "eas:release:android": "npm run eas:sync-env && npm run clean:eas-upload && set EAS_NO_VCS=1&& set NODE_ENV=production&& set EAS_BUILD_NO_EXPO_GO_WARNING=true&& eas build --platform android --profile production --non-interactive",
    "eas:submit:ios": "eas submit --platform ios --profile production --latest --non-interactive",
    "eas:download:ios": "cd ios_release_builds && eas build:download -p ios --non-interactive",
    "eas:download:ios:id": "cd ios_release_builds && eas build:download --build-id",
    "eas:ios": "npm run eas:sync-env && set EAS_NO_VCS=1&& eas build --platform ios --profile preview",
    "eas:ios:preview": "npm run eas:sync-env && npm run clean:eas-upload && set EAS_NO_VCS=1&& eas build --platform ios --profile preview --non-interactive",
    "eas:dev": "npm run eas:build:ios",
    "eas:ios-dev-kur": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ios-dev-telefona-kur.ps1",
    "eas:inspect": "npm run eas:inspect:ios",
    "lint": "eslint .",
    "test": "tsx --test src/utils/portalDetailCardContract.test.ts src/utils/portalPriceStatus.test.ts src/utils/savedQueryDisplay.test.ts src/utils/droneProjectContract.test.ts src/constants/aiDroneProductionPipeline.test.ts services/openAiPreflightApi.test.ts services/runwayPortraitClient.test.ts services/runwaySlotProgress.test.ts services/droneRunwayService.test.ts services/droneScenePreview.test.ts services/droneSceneTimeline.test.ts modules/parcelTerrain3d/utils/validateTerrainPayload.test.ts",
    "copy:icon-fonts": "node ./scripts/copy-icon-fonts-to-android.js",
    "postinstall": "patch-package && npm run copy:icon-fonts",
    "pod-install": "node ./scripts/pod-install-or-skip.mjs"
  },
